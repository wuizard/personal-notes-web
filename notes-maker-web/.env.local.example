# Copy to .env.local and fill from Firebase console → Project settings →
# Your apps → Web app. Without these values the app runs fine — the profile
# icon and sign-in simply do not render (auth is optional, docs/10 §10.6).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# AdSense publisher ID (not secret — it's public in every served page).
# Without it the ad loader never renders (docs/10 §10.13), so local/dev
# environments are safe by default. Free-tier + online only.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-3014369083955512
