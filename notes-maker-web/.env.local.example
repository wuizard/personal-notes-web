# Copy to .env.local and fill from Firebase console → Project settings →
# Your apps → Web app. Without these values the app runs fine — the profile
# icon and sign-in simply do not render (auth is optional, docs/10 §10.6).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# AdSense publisher ID (not secret — it's public in every served page).
# Without it the ad loader never renders (docs/10 §10.13), so local/dev
# environments are safe by default. Free-tier + online only.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-3014369083955512

# AdSense ad unit slot ID for the bottom banner (src/shared/ads/banner-ad.tsx,
# docs/10 §10.13). Create a "Display ad" unit in the AdSense dashboard under
# Ads → By ad unit → Display ads, and paste its slot ID here — it's a
# per-unit numeric ID, distinct from the publisher client ID above. Blank
# means the banner renders nothing, same pattern as every other optional key
# in this file.
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=

# Paddle client-side token and $2/month price ID (docs/10 §10.10, §10.18) —
# create the product/price in the Paddle dashboard, then get the token from
# Developer Tools → Authentication. Both are public, safe to ship client-side
# (same safety class as the retired Polar Checkout Link — they identify the
# product, not a credential). Leave blank locally and the "Upgrade to
# Premium" screen shows "not set up yet" instead of a dead button.
#
# WARNING: setting these makes the Subscribe button charge a REAL card
# unless NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox (below) with sandbox
# token/price values. See src/features/billing/paddle.ts and docs/10 §10.18.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=

# "sandbox" to test against Paddle's sandbox environment (use sandbox
# token/price above too — they're separate from live ones); blank for
# production, Paddle.js defaults to production.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=

# notes-maker-api base URL (docs/01 §1.3 — runtime config, never
# same-origin-coupled). Unset, checkRemotePlan() always resolves "free"
# (docs/10 §10.17) rather than throwing. Local dev: http://localhost:8080
NEXT_PUBLIC_API_URL=
