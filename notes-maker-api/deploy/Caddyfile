# Reverse proxy for notes-maker-api. Caddy gets/renews the Let's Encrypt
# cert automatically as long as api.quickchecklist.app's DNS record points
# at this VPS and ports 80/443 are open.
#
# quickchecklist.app itself is also on this VPS (notes-maker-web/deploy/
# Caddyfile) and IS proxied (orange cloud) through Cloudflare, using a
# Cloudflare Origin CA cert instead of Let's Encrypt. api.quickchecklist.app
# stays "DNS only" (grey cloud) here on purpose: a proxied record would put
# Cloudflare's edge in front of the ACME HTTP-01 challenge and Cloudflare's
# own TLS in front of Caddy's, which this simple setup isn't set up to
# negotiate. Set it once in the Cloudflare dashboard: DNS -> api -> A record
# -> click the cloud icon to grey/"DNS only".
#
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

api.quickchecklist.app {
	reverse_proxy 127.0.0.1:8080

	# Polar webhook deliveries can run a few KB of JSON; the handler itself
	# already caps the read at 1MiB (polar_webhook.go), this just keeps
	# Caddy from rejecting anything unusually large before it gets there.
	request_body {
		max_size 2MB
	}

	encode gzip
}
