# Copy to /opt/notes-maker-api/api.env on the VPS, fill in real values,
# then: chmod 600 api.env && chown root:root api.env
# This is EnvironmentFile= for notes-maker-api.service (systemd loads it
# directly — no .env dotfile parsing happens in production, see config.go's
# loadDotEnv comment: real env vars always win, this file just supplies them).

PORT=8080

# Matches the readWrite user created by init-replica-and-user.sh, scoped to
# notes_maker only (authSource=notes_maker, not admin — least privilege).
MONGO_URI=mongodb://notes_maker_app:REPLACE_ME@127.0.0.1:27017/notes_maker?replicaSet=rs0&authSource=notes_maker
MONGO_DB_NAME=notes_maker

# scp'd separately, outside git, mode 600.
FIREBASE_CREDENTIALS_FILE=/opt/notes-maker-api/firebase-adminsdk.json

# Paddle Dashboard -> Developer Tools -> Notifications -> destination for
# https://api.quickchecklist.app/webhooks/paddle -> secret key (pdl_ntfset_...).
PADDLE_WEBHOOK_SECRET=

# Paddle Dashboard -> Developer Tools -> Authentication -> API keys. Not
# consumed by any code path yet — reserved for direct Paddle API calls.
PADDLE_API_KEY=

# The frontend's real production origin, not localhost:3000. Add a
# comma-separated second entry here if the site is also reachable at
# www.quickchecklist.app.
ALLOWED_ORIGINS=https://quickchecklist.app

# Seals synced note content at rest. Generate with: openssl rand -base64 32
#
# BACK THIS UP wherever the other production secrets live. Losing every key
# listed here means losing every synced note — there is no recovery path, by
# construction. Rotating means adding a higher-numbered key and KEEPING the
# old one: "1:<old base64>,2:<new base64>". Notes re-seal under the new key
# lazily, on their next edit.
NOTES_ENCRYPTION_KEY=
