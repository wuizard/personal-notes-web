# Copy to .env and fill in real values. .env is gitignored (see repo root
# .gitignore) — never commit real credentials. Loaded automatically by
# config.Load() for local dev; real environment variables (CI, deployment
# secrets) always take priority over this file.

PORT=8080

# Local docker-compose Mongo has no auth (see docker-compose.yml) — this
# default is fine unless pointing at a hosted/Atlas cluster.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=notes_maker

# Path to the Firebase Admin SDK service account JSON (Firebase console ->
# Project settings -> Service accounts -> Generate new private key). Never
# commit this file; keep it outside version control same as this .env.
FIREBASE_CREDENTIALS_FILE=

# Paddle sandbox/production dashboard -> Developer Tools -> Notifications ->
# your webhook destination -> signing secret (starts pdl_ntfset_).
PADDLE_WEBHOOK_SECRET=

# Paddle dashboard -> Developer Tools -> Authentication -> API keys.
# Not consumed by any code path yet - reserved for direct Paddle API calls.
PADDLE_API_KEY=

ALLOWED_ORIGINS=http://localhost:3000

# Seals synced note content at rest. Generate one with:
#   openssl rand -base64 32
# Format: a bare base64 key (read as version 1), or comma-separated
# "<version>:<base64>" entries when rotating — keep the old key in the list
# or every note sealed under it becomes permanently unreadable.
NOTES_ENCRYPTION_KEY=
